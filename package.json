{
  "name": "ai-pr-reviewer-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "AI Pull Request Reviewer — GitHub Action, reusable npm package, and CLI",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/github-action"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b --pretty && node scripts/bundle-action.mjs",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node packages/cli/dist/index.js --demo",
    "pack:dry": "npm pack --dry-run -w @larva-factory/ai-pr-reviewer",
    "bundle:action": "node scripts/bundle-action.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
