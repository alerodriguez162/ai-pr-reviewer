# GitHub personal access token or GITHUB_TOKEN from Actions.
# Required scopes for local CLI: repo (private) or public_repo (public).
GITHUB_TOKEN=

# OpenAI API key used by the review engine.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# AI_PR_REVIEW_MAX_FILES=40
# AI_PR_REVIEW_MAX_DIFF_CHARS=8000
